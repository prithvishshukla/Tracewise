# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.
# ---- Mode -------------------------------------------------------------------
# demo: no authentication, simulated demo data is expected. production: API requires API_TOKEN.
TRACEWISE_MODE=demo
NODE_ENV=development
LOG_LEVEL=info

# ---- Infrastructure -----------------------------------------------------------
DATABASE_URL=postgres://postgres:tracewise@127.0.0.1:5432/tracewise
REDIS_URL=redis://127.0.0.1:6379
# bullmq: jobs go through Redis and a separate worker. inline: jobs run inside the API process (no Redis/worker needed).
QUEUE_MODE=bullmq

# ---- API / web --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Used by the Next.js server to reach the API.
API_URL=http://127.0.0.1:4000
# Production mode only: the API requires this bearer token; the web server sends the same value (server-side only).
API_TOKEN=
TRACEWISE_API_TOKEN=

# ---- Repository scanning --------------------------------------------------------------
# Local repositories must live inside one of these directories. Separator: ; on Windows, : on macOS/Linux.
# Windows example: SCAN_ROOTS=C:\Users\you\projects;C:\Users\you\Documents\tracewise\fixtures\sample-repositories
# Default (when empty): the fixtures/sample-repositories folder of this project.
SCAN_ROOTS=
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
SCAN_MAX_FILES=5000
SCAN_MAX_FILE_BYTES=1000000
SCAN_MAX_TOTAL_BYTES=50000000
SCAN_TIMEOUT_MS=60000

# ---- Monitoring ----------------------------------------------------------------------------
# Live feeds (GitHub release Atom feeds, GitHub changelog RSS) are only contacted when this is true or enabled in Settings.
ENABLE_LIVE_POLLING=false
POLL_INTERVAL_MINUTES=360
FETCH_TIMEOUT_MS=15000
# Tests only: allow fetching from private/loopback addresses. Keep false otherwise (SSRF protection).
FETCH_ALLOW_PRIVATE=false

# ---- Optional AI-assisted changelog extraction ------------------------------------------------
# Disabled by default. Only public changelog text is sent; repository code is never sent.
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
